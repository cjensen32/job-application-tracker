# Maven build output
target/

.idea/*

# Keep shared configs
!.idea/runConfigurations/
!.idea/codeStyles/
!.idea/inspectionProfiles/
!.idea/vcs.xml
!.idea/modules.xml

*.swp
*.swo

# Avoid indexing codegraph churn or claude churn
.codegraph/
.claude/

# Local agent state lives under the shared .agents directory
.agents/settings.local.json
.agents/worktrees/
.agents/notes
***/.DS_Store

# Scratch commit message buffer
commit_msg.txt
