#!/bin/sh
#
# Prefix every commit subject with a sequential C### counter.
#
# The next number is derived from HEAD's own subject, so there is no stored
# state to drift and a branch that diverges simply keeps counting from its
# branch point.
#
# Enable once per clone:
#   git config core.hooksPath .githooks

msg_file="$1"
msg_source="$2"

# Merge and squash messages are generated by git; leave them alone.
case "$msg_source" in
  merge | squash) exit 0 ;;
esac

# Already numbered -- amend, rebase, or a hand-written prefix. Never re-bump.
if head -n 1 "$msg_file" | grep -Eq '^C[0-9]{3,} '; then
  exit 0
fi

current=$(git log -1 --format=%s 2>/dev/null | sed -n 's/^C0*\([0-9][0-9]*\) .*/\1/p')
[ -n "$current" ] || current=0
next=$(printf 'C%03d' "$((current + 1))")

tmp="$msg_file.seq"
{ printf '%s ' "$next"; cat "$msg_file"; } >"$tmp" && mv "$tmp" "$msg_file"
